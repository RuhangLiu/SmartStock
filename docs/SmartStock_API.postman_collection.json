                  "value": "20"
                },
                {
                  "key": "type",
                  "value": ""
                },
                {
                  "key": "search",
                  "value": ""
                }
              ]
            },
            "description": "Returns searchable, filterable, paginated inventory movement history with signed change, before/after balances, operator, reason, timestamp, and source reference. Access: Admin and Employee (read only).",
