    {
      "name": "Authentication",
      "item": [
        {
          "name": "POST Log in",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Validates user credentials and creates a seven-day authenticated session. Access: Public.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@smartstock.com\",\n  \"password\": \"admin123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login succeeds', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "if (body.data && body.data.token) pm.collectionVariables.set('adminToken', body.data.token);"
                ]
              }
            }
          ]
        },
